{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PlanMaster Lane",
  "scopeName": "source.planmaster-lane",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#fence"
    },
    {
      "include": "#front-matter-key"
    },
    {
      "include": "#item-todo"
    },
    {
      "include": "#item-doing"
    },
    {
      "include": "#item-blocked"
    },
    {
      "include": "#item-done"
    },
    {
      "include": "#item-dropped"
    }
  ],
  "repository": {
    "comment": {
      "match": "^\\s*<!--.*-->\\s*$",
      "name": "comment.block.planmaster"
    },
    "fence": {
      "match": "^---\\s*$",
      "name": "punctuation.definition.tag.planmaster"
    },
    "front-matter-key": {
      "match": "^(format|lane|title)(:)\\s*(.*)$",
      "captures": {
        "1": {
          "name": "keyword.other.planmaster"
        },
        "2": {
          "name": "punctuation.separator.planmaster"
        },
        "3": {
          "name": "string.unquoted.planmaster"
        }
      }
    },
    "token": {
      "match": "(?<=\\s)(tag|ref|wait|since|done)(:)(\\S+)",
      "captures": {
        "1": {
          "name": "variable.parameter.planmaster.key"
        },
        "2": {
          "name": "punctuation.separator.planmaster"
        },
        "3": {
          "name": "string.unquoted.planmaster.value"
        }
      }
    },
    "item-todo": {
      "begin": "^(\\s*)(-)\\s(\\[)( )(\\])\\s+([A-Z][A-Z0-9]{0,3}-\\d+(?:[a-z][a-z0-9]*)?)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.list.begin.markdown"
        },
        "3": {
          "name": "punctuation.definition.bracket.planmaster"
        },
        "4": {
          "name": "constant.character.planmaster.state.todo"
        },
        "5": {
          "name": "punctuation.definition.bracket.planmaster"
        },
        "6": {
          "name": "entity.name.function.planmaster.id"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#token"
        }
      ]
    },
    "item-doing": {
      "begin": "^(\\s*)(-)\\s(\\[)(~)(\\])\\s+([A-Z][A-Z0-9]{0,3}-\\d+(?:[a-z][a-z0-9]*)?)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.list.begin.markdown"
        },
        "3": {
          "name": "punctuation.definition.bracket.planmaster"
        },
        "4": {
          "name": "constant.character.planmaster.state.doing"
        },
        "5": {
          "name": "punctuation.definition.bracket.planmaster"
        },
        "6": {
          "name": "entity.name.function.planmaster.id"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#token"
        }
      ]
    },
    "item-blocked": {
      "begin": "^(\\s*)(-)\\s(\\[)(!)(\\])\\s+([A-Z][A-Z0-9]{0,3}-\\d+(?:[a-z][a-z0-9]*)?)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.list.begin.markdown"
        },
        "3": {
          "name": "punctuation.definition.bracket.planmaster"
        },
        "4": {
          "name": "constant.character.planmaster.state.blocked"
        },
        "5": {
          "name": "punctuation.definition.bracket.planmaster"
        },
        "6": {
          "name": "entity.name.function.planmaster.id"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#token"
        }
      ]
    },
    "item-done": {
      "begin": "^(\\s*)(-)\\s(\\[)(x)(\\])\\s+([A-Z][A-Z0-9]{0,3}-\\d+(?:[a-z][a-z0-9]*)?)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.list.begin.markdown"
        },
        "3": {
          "name": "punctuation.definition.bracket.planmaster"
        },
        "4": {
          "name": "constant.character.planmaster.state.done"
        },
        "5": {
          "name": "punctuation.definition.bracket.planmaster"
        },
        "6": {
          "name": "entity.name.function.planmaster.id"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#token"
        }
      ]
    },
    "item-dropped": {
      "begin": "^(\\s*)(-)\\s(\\[)(\\-)(\\])\\s+([A-Z][A-Z0-9]{0,3}-\\d+(?:[a-z][a-z0-9]*)?)(?=\\s|$)",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.list.begin.markdown"
        },
        "3": {
          "name": "punctuation.definition.bracket.planmaster"
        },
        "4": {
          "name": "constant.character.planmaster.state.dropped"
        },
        "5": {
          "name": "punctuation.definition.bracket.planmaster"
        },
        "6": {
          "name": "entity.name.function.planmaster.id"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#token"
        }
      ]
    }
  }
}
