{
  "name": "planmaster",
  "version": "0.1.0",
  "private": true,
  "description": "Visual queue of Claude Code lane work for VS Code. Core library and command-line checker.",
  "type": "module",
  "engines": {
    "node": ">=20",
    "vscode": "^1.90.0"
  },
  "bin": {
    "planmaster-lint": "out/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "dup": "jscpd",
    "dead": "knip",
    "smells": "npm run lint && npm run dup && npm run dead",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:shuffle": "vitest run --project unit --sequence.shuffle",
    "test:tz": "node scripts/test-tz.mjs",
    "coverage": "vitest run --project unit --coverage",
    "check": "npm run typecheck && npm run smells && npm run coverage && npm run test:shuffle && npm run test:tz && npm run test:integration && npm run test:extension",
    "lint:demo": "npm run build && node out/cli/main.js docs/examples/demo-workspace --now 2026-11-02T11:48 --mtime E=2026-11-02T08:07",
    "bundle": "node scripts/bundle.mjs",
    "test:extension": "npm run bundle && xvfb-run -a node scripts/test-extension.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "happy-dom": "^21.0.4",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.0"
  },
  "displayName": "PlanMaster",
  "publisher": "planmaster",
  "license": "UNLICENSED",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:.planmaster/config.json",
    "workspaceContains:.planmaster/lanes/*.md"
  ],
  "contributes": {
    "languages": [
      {
        "id": "planmaster-lane",
        "aliases": [
          "PlanMaster Lane"
        ],
        "filenamePatterns": [
          "**/.planmaster/lanes/*.md",
          "**/.planmaster/archive/*.md"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "planmaster-lane",
        "scopeName": "source.planmaster-lane",
        "path": "./syntaxes/planmaster-lane.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "planmaster.runLint",
        "title": "Re-Check All Lanes",
        "category": "PlanMaster"
      },
      {
        "command": "planmaster.markSeen",
        "title": "Mark Everything as Seen",
        "category": "PlanMaster"
      }
    ],
    "configuration": {
      "title": "PlanMaster",
      "properties": {
        "planmaster.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the PlanMaster item in the status bar."
        },
        "planmaster.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Publish queue problems to the Problems panel."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "planmaster",
          "title": "PlanMaster",
          "icon": "media/queue.svg"
        }
      ]
    },
    "views": {
      "planmaster": [
        {
          "type": "webview",
          "id": "planmaster.queue",
          "name": "Queue"
        }
      ]
    }
  }
}
